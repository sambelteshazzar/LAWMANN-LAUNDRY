# Local dev runs on PGlite (embedded Postgres), so there is nothing to set up.
# Production swaps one driver in src/lib/db/index.ts and needs a connection string.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs staff session cookies. 16+ characters. Required before the owner demo.
# SESSION_SECRET=

# Arkesel bulk SMS (https://arkesel.com). Without this, messages stay queued
# in the outbox and are shown, never faked as sent.
# ARKESEL_API_KEY=

# One-time production bootstrap (npm run db:bootstrap). Both optional:
# BOOTSTRAP_OWNER_NAME=Owner
# BOOTSTRAP_PIN=
